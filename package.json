{
  "name": "@quxkit/tenant-kit",
  "version": "0.2.0",
  "packageManager": "pnpm@11.20.0",
  "description": "Multi-tenancy as a library \u2014 tenant identity, membership, resolution and isolation for the app you already run.",
  "license": "Apache-2.0",
  "author": "BRETT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuxKit/tenant-kit.git"
  },
  "homepage": "https://github.com/QuxKit/tenant-kit#readme",
  "bugs": {
    "url": "https://github.com/QuxKit/tenant-kit/issues"
  },
  "keywords": [
    "multi-tenancy",
    "multitenant",
    "tenant",
    "saas",
    "row-level-security",
    "rls",
    "organizations",
    "memberships",
    "postgres",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./pg": {
      "types": {
        "import": "./dist/pg.d.ts",
        "require": "./dist/pg.d.cts"
      },
      "import": "./dist/pg.mjs",
      "require": "./dist/pg.cjs"
    },
    "./express": {
      "types": {
        "import": "./dist/express.d.ts",
        "require": "./dist/express.d.cts"
      },
      "import": "./dist/express.mjs",
      "require": "./dist/express.cjs"
    },
    "./hono": {
      "types": {
        "import": "./dist/hono.d.ts",
        "require": "./dist/hono.d.cts"
      },
      "import": "./dist/hono.mjs",
      "require": "./dist/hono.cjs"
    },
    "./next": {
      "types": {
        "import": "./dist/next.d.ts",
        "require": "./dist/next.d.cts"
      },
      "import": "./dist/next.mjs",
      "require": "./dist/next.cjs"
    },
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sql",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 'test/**/*.test.ts'",
    "test:coverage": "c8 --check-coverage tsx --test --test-concurrency=1 'test/**/*.test.ts'",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm test"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "c8": "^12.0.0",
    "pg": "^8.23.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "express": ">=4",
    "hono": ">=4",
    "next": ">=14",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
